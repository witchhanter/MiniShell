//MiniShell v0.0.4-alpha.
//Автор:
// ======= Ерофеев Игорь =======

//имена основных файлов:
конст АлиасыЮзер = "aliases_user.txt"
конст ИсторияКоманд = "commands.txt"
конст Логи = "logs.txt"

метод Скрипт()
    
    // ===================================================
    // = Введите "help" для показа всех доступных команд =
    // ===================================================
    
    пер РабочаяПапка = ПутьКРабочейПапкеИЕёСоздание()
    пер Разд = Разделитель()
    пер ФайлАлиасовЮзера = новый Файл(РабочаяПапка + Разд + АлиасыЮзер)
    пер ФайлИсторииКоманд = новый Файл(РабочаяПапка + Разд + ИсторияКоманд)
    пер Команда: Строка
    пер ТекущаяПапка = новый Файл(РабочаяПапка)
    пер Настройки = новый НастройкиПоискаФайлов()
    Настройки.МаксимальнаяГлубина(1)
    пер СчетчикКоманд: Число
    пер ПомощьККомандам = ПомощьКоманд(ТекущаяПапка)
    //очистка истории команд
    если ФайлИсторииКоманд.Существует()
        Файлы.Удалить(ФайлИсторииКоманд)
    ;
    Файлы.Создать(ФайлИсторииКоманд)
    //создание алиасов по умолчанию
    если не ФайлАлиасовЮзера.Существует()
        ДефолтАлиасы(ФайлАлиасовЮзера)
    ;
    ПоказатьASCIIArt()
    //основной цикл
    пока Истина
        пер Выполнение = Ложь
        Команда = Консоль.СчитатьСтроку("\н$ТекущаяПапка> ")
        пока Команда.Сократить() == ""
            Команда = Консоль.СчитатьСтроку("\н$ТекущаяПапка> ")
        ;
        //запись команд в логи
        historyActivate(Команда, ФайлИсторииКоманд)
        СчетчикКоманд += 1
        
        
        // парсинг команды
        пер Части = ПарсерКоманды(Команда)
        
        
        // получение команд по алиасам (если есть)
        Части = ЗаменаАлиасовНаКоманды(ФайлАлиасовЮзера, Части)
        пер КомандаИмя = Части[0]
        // !!
        если СчетчикКоманд == 1 и Команда == "!!"
            Консоль.Записать("Предыдущей команды нет.")
            Выполнение = Истина
        иначе
            если Части.Размер() == 1 и Части[0] == "!!"
                Команда = repeatCommand(ФайлИсторииКоманд)
                если Команда != "!!"
                    Консоль.Записать("\н$ТекущаяПапка> $Команда")
                    Выполнение = Ложь
                    Части = Команда.Разделить(" ", Ложь)
                    КомандаИмя = Части[0]
                иначе
                    Консоль.Записать("Предыдущая команда не должна быть \"!!\", иначе это вызовет бесконечный цикл.")
                    Выполнение = Истина
                ;
            ;
        ;
        
        
        
        
        
        // --help
        пер ЕстьПомощь = Ложь
        для Индекс = 1 по Части.Размер() - 1
            если Части[Индекс] == "--help"
                ЕстьПомощь = Истина
                прервать
            ;
        ;
        если ЕстьПомощь
            help(КомандаИмя, ПомощьККомандам)
            Выполнение = Истина
        ;
        
        // help
        пер НомерКоманды = 1
        если КомандаИмя == "help" и Части.Размер() == 1
            для ПомощьККоманде из ПомощьККомандам
                Консоль.Записать("[$НомерКоманды] ${ПомощьККоманде.Значение}")
                НомерКоманды += 1
            ;
            Выполнение = Истина
        ;

        
        
        // Основной выбор
        если Выполнение == Ложь
            пер МассивНаВывод: Массив<Строка>
            если КомандаИмя == "cd"
                ТекущаяПапка = cd(Части, ТекущаяПапка)
                
            // =====================================================
            // > и >>
            иначе если Части.Содержит(">>") или Части.Содержит(">")
                пер Знак: Строка
                если Части.Содержит(">")
                    Знак = ">"
                иначе
                    Знак = ">>"
                ;
                пер ЧастиПодстава = новый Массив<Строка>()
                для Элемент из Части
                    ЧастиПодстава.Добавить(Элемент)
                ;
                ЧастиПодстава.УдалитьПоИндексу(ЧастиПодстава.Граница())
                ЧастиПодстава.Удалить(Знак)
                
                МассивНаВывод = ОсновныеКоманды(Команда, ЧастиПодстава, КомандаИмя, ТекущаяПапка, РабочаяПапка, Выполнение, Разд, Настройки, ФайлИсторииКоманд, ФайлАлиасовЮзера, ПомощьККомандам)
                // Консоль.Записать("Массив на вывод: " + МассивНаВывод)
                пер ФайлДляЗаписи = новый Файл(ТекущаяПапка + Разд + Части[Части.Граница()])
                
                если Части.Содержит(">")
    
                    если ФайлДляЗаписи.Существует()
                        Файлы.Удалить(ФайлДляЗаписи)
                    ;
                    Файлы.Создать(ФайлДляЗаписи)
                    
                    для Элемент из МассивНаВывод
                        исп ПотокЗаписи = ФайлДляЗаписи.ОткрытьПотокЗаписи(Истина)
                        знч Запись = новый ЗаписьДанных(ПотокЗаписи)
                        Запись.ЗаписатьСтроку(Элемент)
                    ;
                иначе если Части.Содержит(">>")
                    если не ФайлДляЗаписи.Существует()
                        Файлы.Создать(ФайлДляЗаписи)
                    ; 
                    
                    для Элемент из МассивНаВывод
                        исп ПотокЗаписи = ФайлДляЗаписи.ОткрытьПотокЗаписи(Истина)
                        знч Запись = новый ЗаписьДанных(ПотокЗаписи)
                        Запись.ЗаписатьСтроку(Элемент)
                    ;
                ;
            // =====================================================
             
                
                
            иначе
                МассивНаВывод = ОсновныеКоманды(Команда, Части, КомандаИмя, ТекущаяПапка, РабочаяПапка, Выполнение, Разд, Настройки, ФайлИсторииКоманд, ФайлАлиасовЮзера, ПомощьККомандам)
                для Строка из МассивНаВывод
                    Консоль.Записать(Строка)
                ;
            ;
            
            
        ; 
    ;
;

метод ОсновныеКоманды(Команда: Строка, Части: Массив<Строка>, КомандаИмя: Строка, ТекущаяПапка: Файл, РабочаяПапка: Строка, Выполнение: Булево, Разд: Строка, Настройки: НастройкиПоискаФайлов, ФайлИсторииКоманд: Файл, ФайлАлиасовЮзера: Файл, ПомощьККомандам: Соответствие<Строка, Строка>): Массив<Строка>
    пер ВозвратКоманды: Массив<Строка>
            выбор КомандаИмя
            
            //выполняют действие
            когда "cd"//
                ТекущаяПапка = cd(Части, ТекущаяПапка)
            когда "clear"//
                clear()
            когда "poweroff", "exit"//
                poweroff()
            когда "rm"//
                rm(Части)
            когда "rmdir"//
                rmdir(Части)
            когда "cp"//
                cp(Части)
            когда "mv"//
                mv(Части)
            когда "qr"//
                qr(Части, РабочаяПапка)
            когда "mkdir"
                mkdir(Части, Выполнение, Разд)   
            когда "touch"
                touch(Части, ТекущаяПапка, Разд)
                
            //возвращают результат
            когда "alias"
                ВозвратКоманды = АлиасыЮзера(Части, ФайлАлиасовЮзера, ПомощьККомандам, Команда)
            когда "history"
                ВозвратКоманды = history(ФайлИсторииКоманд)    
            когда "curl"
                ВозвратКоманды = curl(Части)
            когда "cat"
                ВозвратКоманды = cat(Части, ТекущаяПапка, Разд)  
            когда "ls"
                ВозвратКоманды = ls(Части, Настройки, ТекущаяПапка, РабочаяПапка, Разд, Выполнение)
            когда "echo"
                ВозвратКоманды = echo(Части, ТекущаяПапка, Разд)
            когда "whoami"
                ВозвратКоманды = whoami()
            когда "date"
                ВозвратКоманды = date()
            когда "time"
                ВозвратКоманды = time()
            когда "arch"
                ВозвратКоманды = arch()
            когда "uname"
                ВозвратКоманды = uname()
            когда "findtext"
                ВозвратКоманды = findtext(Части, ТекущаяПапка, Разд)
            иначе
                Консоль.Записать(
                "Ошибка: Команда \"$Команда\" не найдена.
                Для большей информации попробуйте: $Команда --help")
            ;
    возврат ВозвратКоманды
;

метод findtext(Части: Массив<Строка>, ТекущаяПапка: Файл, Разд: Строка): Массив<Строка>
    пер МассивСтрок: Массив<Строка>
    пер ФайлДляПоиска: Строка
    если Части.Размер() >= 3
        если не Части[2].Содержит(Разд)
            ФайлДляПоиска = ТекущаяПапка + Разд + Части[2]
        иначе
            ФайлДляПоиска = Части[2]
        ;
        пер ТекстДляПоиска = Части[1]
        если новый Файл(ФайлДляПоиска).Существует()
            исп ПотокПоиска = новый Файл(ФайлДляПоиска).ОткрытьПотокЧтения()
            знч Поиск = новый ЧтениеДанных(ПотокПоиска)
            пока не Поиск.ЧтениеЗавершено()
                пер Строка = Поиск.ПрочитатьСтроку()
                если Строка.Содержит(ТекстДляПоиска)
                    МассивСтрок.Добавить(Строка)
                ;
            ;
        ;
    иначе
        Консоль.Записать("Ошибка: неверные аргументы")
    ;
    возврат МассивСтрок
;

метод uname(): Массив<Строка>
    пер Вывод = [СредаИсполнения.ПолучитьСвойство("os.version").Представление()]
    // Консоль.Записать(Вывод)
    возврат Вывод
;
метод arch(): Массив<Строка>
    пер Вывод = [СредаИсполнения.ПолучитьСвойство("os.arch").Представление()]
    // Консоль.Записать(Вывод)
    возврат Вывод
;
метод time(): Массив<Строка>
    пер Вывод = [Время.Сейчас().Представление("ЧЧ:мм:сс")]
    // Консоль.Записать(Вывод)s
    возврат Вывод
;
метод date(): Массив<Строка>
    пер Вывод = [Дата.Сейчас().Представление("ддд дд ММММ гггг")]
    // Консоль.Записать(Вывод)
    возврат Вывод
;
метод whoami(): Массив<Строка>
    пер Вывод = [СредаИсполнения.ПолучитьПеременную("USER").Представление()]
    // Консоль.Записать(Вывод)
    возврат Вывод
;

    

// метод ЗаменаАлиасовНаКоманды(ФайлАлиасовЮзера: Файл, Команда: Строка): Строка
//     если ФайлАлиасовЮзера.Существует()
//         исп ПотокЧтения = ФайлАлиасовЮзера.ОткрытьПотокЧтения()
//         знч Чтение = новый ЧтениеДанных(ПотокЧтения)
//         пока не Чтение.ЧтениеЗавершено()
//             пер СтрокаДляПроверки = Чтение.ПрочитатьСтроку()
//             если СтрокаДляПроверки.Пусто()
//                 продолжить
//             ;
//             пер ЧастиСтроки = ПарсерКоманды(СтрокаДляПроверки) // Формат: ["алиас", "-", "команда"]
//             если ЧастиСтроки.Размер() >= 3 и ЧастиСтроки[0] == Команда.Сократить()
//                 Команда = ЧастиСтроки[2]
//             иначе если ЧастиСтроки.Размер() >= 2 и ЧастиСтроки[0] == Команда.Сократить()
//                 Команда = ЧастиСтроки[1]
//             ;
//         ;
//     ;
//     возврат Команда
// ;
метод ЗаменаАлиасовНаКоманды(ФайлАлиасовЮзера: Файл, Части: Массив<Строка>): Массив<Строка>
    если ФайлАлиасовЮзера.Существует()
        исп ПотокЧтения = ФайлАлиасовЮзера.ОткрытьПотокЧтения()
        знч Чтение = новый ЧтениеДанных(ПотокЧтения)
        пока не Чтение.ЧтениеЗавершено()
            пер СтрокаДляПроверки = Чтение.ПрочитатьСтроку()
            если СтрокаДляПроверки.Пусто()
                продолжить
            ;
            пер ЧастиСтроки = ПарсерКоманды(СтрокаДляПроверки) // Формат: ["алиас", "-", "команда"]
            если ЧастиСтроки.Размер() >= 3 и ЧастиСтроки[0] == Части[0]
                пер ИзмененныеЧасти: Массив<Строка>
                ИзмененныеЧасти.Очистить()
                ИзмененныеЧасти.Добавить(ЧастиСтроки[2])
                Части.УдалитьПоИндексу(0)
                для Часть из Части
                    ИзмененныеЧасти.Добавить(Часть)
                ;
                возврат ИзмененныеЧасти
            ;
        ;
    ;
    возврат Части
;

метод АлиасыЮзера(Части: Массив<Строка>, ФайлАлиасовЮзера: Файл, Команды: Соответствие<Строка, Строка>, Команда: Строка): Массив<Строка>
    пер МассивСтрок: Массив<Строка>
    если ФайлАлиасовЮзера.Существует()
        пер Действие: Строка
        
        если Части.Размер() == 1
            исп ПотокЧтения = ФайлАлиасовЮзера.ОткрытьПотокЧтения()
            знч Чтение = новый ЧтениеДанных(ПотокЧтения)
            пока не Чтение.ЧтениеЗавершено()
                пер Алиас = Чтение.ПрочитатьСтроку()
                если Алиас.Сократить() != ""
                    МассивСтрок.Добавить(Алиас)
                ;
            ;
        ;
        
        // проверка наличия алиаса в записанных для исключения повторной записи одного алиаса
        пер НаличиеВЗаписанных = Ложь
        если Части.Размер() >= 3
            исп ПотокЧтения1 = ФайлАлиасовЮзера.ОткрытьПотокЧтения()
            знч Чтение1 = новый ЧтениеДанных(ПотокЧтения1)
            пока не Чтение1.ЧтениеЗавершено()
                пер СтрокаДляПроверки = Чтение1.ПрочитатьСтроку()
                если СтрокаДляПроверки.Пусто()
                    продолжить
                ;
                пер ЧастиСтроки = ПарсерКоманды(СтрокаДляПроверки) // Формат: ["алиас", "-", "команда"]
                если ЧастиСтроки[0] == Части[2]
                    НаличиеВЗаписанных = Истина
                ;
            ;
        ;
        
        если Части.Размер() == 4 и Части[1] == "add" и Команды.СодержитКлюч((Части[2])) == Ложь и Части[2] != Части[3] и НаличиеВЗаписанных == Ложь
            Действие = "добавления"
            исп ПотокЗаписи = ФайлАлиасовЮзера.ОткрытьПотокЗаписи(Истина)
            знч Запись = новый ЗаписьДанных(ПотокЗаписи)
            Запись.ЗаписатьСтроку("\"${Части[2]}\" - \"${Части[3]}\"")
            // Консоль.Записать("Алиас \"${Части[2]}\" - \"${Части[3]}\" добавлен успешно")
            
        иначе если Части.Размер() == 3 и Части[1] == "remove" и НаличиеВЗаписанных == Истина
            Действие = "удаления"
            исп ПотокЧтения = ФайлАлиасовЮзера.ОткрытьПотокЧтения()
            знч Чтение = новый ЧтениеДанных(ПотокЧтения)
            Файлы.Удалить(ФайлАлиасовЮзера)
            Файлы.Создать(ФайлАлиасовЮзера)
            пока не Чтение.ЧтениеЗавершено()
                пер Строка = Чтение.ПрочитатьСтроку()
                пер ЧастиАлиаса = ПарсерКоманды(Строка) // получаем алиас, "-" и команду
                если не ЧастиАлиаса.Содержит(Части[2])
                    если не Строка.Пусто()
                        исп ПотокЗаписи = ФайлАлиасовЮзера.ОткрытьПотокЗаписи(Истина)
                        знч Запись = новый ЗаписьДанных(ПотокЗаписи)
                        Запись.ЗаписатьСтроку(Строка)
                    ;
                    
                ;
            ;
            // Консоль.Записать("Алиас \"${Части[2]}\" удален успешно.")
        
        иначе если Части.Размер() != 1
            // Консоль.Записать("Ошибка $Действие: Неверные аргументы.")
        ;
        
    иначе
        // Консоль.Записать("Файл с алиасами пользователя не найден.")
    ;
    возврат МассивСтрок
;

метод ДефолтАлиасы(ФайлАлиасовЮзера: Файл)
    пер Алиасы = ["\"h\" - \"history\"", "\"q\" - \"exit\"", "\"ll\" - \"ls files\"", "\"cls\" - \"clear\""]
    для Алиас из Алиасы
        исп ПотокЗаписи = ФайлАлиасовЮзера.ОткрытьПотокЗаписи(Истина)
        пер ЗаписьДанных = новый ЗаписьДанных(ПотокЗаписи)
        ЗаписьДанных.ЗаписатьСтроку(Алиас)
    ;
;

метод help(КомандаИмя: Строка, ПомощьККомандам: Соответствие<Строка, Строка>)
    если ПомощьККомандам.СодержитКлюч(КомандаИмя) == Истина
        Консоль.Записать(ПомощьККомандам.Получить(КомандаИмя))
    иначе если КомандаИмя == "help"
        для Команда из ПомощьККомандам
            Консоль.Записать(Команда.Значение)
        ;
    иначе
        Консоль.Записать("Неизвестная Команда")
    ;
;

метод ПомощьКоманд(ТекущаяПапка: Файл): Соответствие<Строка, Строка>
    пер ПомощьККомандам = новый Соответствие<Строка, Строка>()
    ПомощьККомандам.Вставить("help", "help - вывести все доступные команды")
    ПомощьККомандам.Вставить("mkdir", "mkdir \"<путь>\" \"<имя папки>\" — создать папку")
    ПомощьККомандам.Вставить("clear", "clear - очистить терминал")
    ПомощьККомандам.Вставить("ls", 
            "ls - вывести список всех объектов в текущей папке ($ТекущаяПапка)
                 Использование аргументов:
                    ls dir - вывести все директории в текущей папке
                    ls .txt - вывести все файлы .txt в текущей папке
                    ls files - вывести все файлы в текущей директории
                    ls .. -r - вывести объекты рекурсивно
                 Запись имен объектов в файл.txt
                    ls > \"<файл.txt>\" - запись пустой файл
                    ls >> \"<файл.txt>\" - запись в конец файла")
    ПомощьККомандам.Вставить("cat" , "cat <файл> — показать содержимое файла")
    ПомощьККомандам.Вставить("history", "history - показать историю введенных комманд")
    ПомощьККомандам.Вставить("cd", 
        "cd \"<путь>\" - изменить текущий рабочий каталог.
             (сейчас - $ТекущаяПапка)")
    ПомощьККомандам.Вставить("!!", "!! - повторить последнюю команду")
    ПомощьККомандам.Вставить("poweroff", "poweroff/exit - выйти из терминала")
    ПомощьККомандам.Вставить("exit", "exit/poweroff - выйти из терминала")
    ПомощьККомандам.Вставить("rm", "rm \"<файл>\" - удалить файл")
    ПомощьККомандам.Вставить("rmdir", "rm \"<каталог>\" - удалить каталог со всем содержимым")
    ПомощьККомандам.Вставить("touch", "touch \"<файл>\" - создать пустой файл")
    ПомощьККомандам.Вставить("cp", "cp \"<источник>\" \"<назначение>\" - копировать объект")
    ПомощьККомандам.Вставить("mv", "mv \"<источник>\" \"<назначение>\" - переместить объект")
    ПомощьККомандам.Вставить("curl", "curl \"<url>\" - выполнить http запрос")
    ПомощьККомандам.Вставить("qr", "qr \"<текст>\" - сгенерировать qr с текстом")
    ПомощьККомандам.Вставить("alias", 
        "alias add \"<алиас>\" \"<команда>\" - задать новый алиас
              alias remove \"<алиас>\" - удалить существующий алиас
              Алиасы по умолчанию:
                 h - history
                 q - exit
                 q - poweroff
                 ll - ls files
                 cls - clear")
    ПомощьККомандам.Вставить("date", "date - получить текущую дата")
    ПомощьККомандам.Вставить("time", "time - получить текущее время")
    ПомощьККомандам.Вставить("arch", "arch - получить архитектуру процессора (аппаратную)")
    ПомощьККомандам.Вставить("uname", "uname - получить версию ядра")
    ПомощьККомандам.Вставить("whoami", "whoami - получить имя авторизованного пользователя")
    ПомощьККомандам.Вставить("echo", 
            "echo \"<текст>\" - вывести в консоль текст
                  Запись имен объектов в файл.txt
                     echo > \"<файл.txt>\" - запись в пустой файл
                     echo >> \"<файл.txt>\" - запись в конец файла")
    ПомощьККомандам.Вставить("findtext", "findtext \"<текст>\" \"<файл>\" - найти все строки, содержащие текст")
    
    возврат ПомощьККомандам
;

метод qr(Части: Массив<Строка>, ПутьДоРабочейПапки: Строка)
    пер РАЗМЕР_МАЛЫЙ = 128
    пер РАЗМЕР_СРЕДНИЙ = 256
    пер РАЗМЕР_БОЛЬШОЙ = 512
    пер ПОРОГ_МАЛЫЙ = 20
    пер ПОРОГ_СРЕДНИЙ = 50
    если Части.Размер() == 2
        Консоль.Записать("Текст для записи: ${Части[1]}")
        пер Выбор = Консоль.СчитатьСтроку("Записать текст в QR-код? [Д/н]  ")
        выбор Выбор.Сократить().ВНижнийРегистр()
        когда "y", "д"
            пер QR_1 = новый ГенераторQrКода(РАЗМЕР_БОЛЬШОЙ, РАЗМЕР_БОЛЬШОЙ, УровеньКоррекцииQrКода.Высокий, ФорматИзображения.Png, Ложь)
            если Части[1].Длина() < ПОРОГ_МАЛЫЙ
                QR_1 = новый ГенераторQrКода(РАЗМЕР_МАЛЫЙ, РАЗМЕР_МАЛЫЙ, УровеньКоррекцииQrКода.Низкий, ФорматИзображения.Png, Ложь)
            иначе если Части[1].Длина() < ПОРОГ_СРЕДНИЙ
                QR_1 = новый ГенераторQrКода(РАЗМЕР_СРЕДНИЙ, РАЗМЕР_СРЕДНИЙ, УровеньКоррекцииQrКода.Средний, ФорматИзображения.Png, Ложь)
            ;
            пер Номер = 1
            пер НовыйQR = новый Файл("$ПутьДоРабочейПапки/QR_$Номер.png")
            пока НовыйQR.Существует()
                Номер = Номер + 1
                НовыйQR = новый Файл("$ПутьДоРабочейПапки/QR_$Номер.png")
            ;
            исп ПотокЗаписи = НовыйQR.ОткрытьПотокЗаписи()
            ПотокЗаписи.Записать(QR_1.КодироватьТекст(Части[1]))
            если НовыйQR.Существует()
                Консоль.Записать("QR-код успешно создан по адресу \"$НовыйQR\"")
            иначе
                Консоль.Записать("Ошибка создания QR-кода.")
            ;
        иначе
            Консоль.Записать("Отмена создания QR-кода.")
        ;
    иначе
        Консоль.Записать(
            "Не задан/задан с ошибкой текст для записи
            qr \"<текст>\""
        )
    ;
;

метод curl(Части: Массив<Строка>): Массив<Строка>
    пер МассивСтрок: Массив<Строка>
    //curl "https://http-test.1cmycloud.com/applications/school/api/diary/schedules/week"
    если Части.Размер() == 2
        пер Путь = Части[1]
        исп Запрос = КлиентHttp.ЗапросGet(Путь).Выполнить()
        пер КодЗапроса = Запрос.КодСтатуса
        пер ТелоЗапроса = Запрос.Тело.ПрочитатьКакСтроку()
        // Консоль.Записать(
        //     "Выполнен GET-запрос на ${Части[1]}.
            
        //     Код запроса: $КодЗапроса
        
        //     Тело запроса:
            
        //     ${ТелоЗапроса}"
        // )       
        МассивСтрок.Добавить(КодЗапроса.ВСтроку())
        МассивСтрок.Добавить(ТелоЗапроса)
    иначе
        // Консоль.Записать(
        //     "Не задан/задан с ошибкой url для запроса
        //     curl \"<url>\""
        // )
    ;
    возврат МассивСтрок

;

метод mv(Части: Массив<Строка>)
    если Части.Размер() == 3 и Части.Размер() != 1
        пер Источник = новый Файл(Части[1])
        пер Назначение = новый Файл(Части[2])
        Файлы.Переместить(Источник.Путь, Назначение.Путь)
        если Назначение.Существует()
            Консоль.Записать("Успешно.")
        иначе
            Консоль.Записать("Ошибка перемещения.")
        ;
    иначе
        Консоль.Записать(
            "Не заданы/заданы с ошибкой пути для перемещения.
            mv \"<источник>\" \"<назначение>\""
        )
    ;
;

метод cp(Части: Массив<Строка>)
    если Части.Размер() == 3
        пер Источник = новый Файл(Части[1])
        пер Назначение = новый Файл(Части[2])
        Файлы.Скопировать(Источник.Путь, Назначение)
        если Источник.Существует() и Назначение.Существует()
            Консоль.Записать("Успешно.")
        иначе
            Консоль.Записать("Ошибка копирования.")
        ;
    иначе
        Консоль.Записать(
            "Не заданы/заданы с ошибкой пути для копирования.
            cp \"<источник>\" \"<назначение>\""
        )
    ;
;

метод touch(Части: Массив<Строка>, ТекущаяПапка: Файл, Разд: Строка)//: Массив<Строка>
    // пер МассивСтрок: Массив<Строка>
    если Части.Размер() == 2
        пер ФайлДляСоздания = новый Файл(ТекущаяПапка + Разд + Части[1])
        Файлы.Создать(ФайлДляСоздания)
        если ФайлДляСоздания.Существует()
            Консоль.Записать("Файл создан успешно по адресу \"$ФайлДляСоздания\".")
            //МассивСтрок.Добавить(ФайлДляСоздания.Путь)
            
        иначе
            Консоль.Записать("Ошибка создания.")
        ;
    иначе
        Консоль.Записать(
            "Не задан/задан с ошибкой путь для создания файла.
            rm \"<файл>\""
        )
    ;
    //возврат МассивСтрок
;

метод rmdir(Части: Массив<Строка>)
    если Части.Размер() == 2
        пер КаталогДляУдаления = новый Файл(Части[1])
        пер Выбор = Консоль.СчитатьСтроку("Удалить каталог по адресу \"$КаталогДляУдаления\"? [Д/н]  ")
        выбор Выбор.Сократить().ВНижнийРегистр()
        когда "y", "д"
            если КаталогДляУдаления.Существует()
                Файлы.Удалить(КаталогДляУдаления)
                Консоль.Записать("Каталог удален.")
            иначе
                Консоль.Записать("Ошибка: Каталог по адресу \"$КаталогДляУдаления\" не существует")
            ;
        иначе
            Консоль.Записать("Отмена удаления.")
        ;
    иначе
        Консоль.Записать(
            "Не задан/задан с ошибкой путь для удаления каталога.
            rm \"<файл>\""
        )
    ;
;

метод rm(Части: Массив<Строка>)
    если Части.Размер() == 2
        пер ФайлДляУдаления = новый Файл(Части[1])
        пер Выбор = Консоль.СчитатьСтроку("Удалить файл по адресу \"$ФайлДляУдаления\"? [Д/н]  ")
        выбор Выбор.Сократить().ВНижнийРегистр()
        когда "y", "д"
            если ФайлДляУдаления.Существует()
                Файлы.Удалить(ФайлДляУдаления)
                Консоль.Записать("Файл удален.")
            иначе
                Консоль.Записать("Ошибка: Файл по адресу \"$ФайлДляУдаления\" не существует")
            ;
        иначе
            Консоль.Записать("Отмена удаления.")
        ;
    иначе
        Консоль.Записать(
            "Не задан/задан с ошибкой путь для удаления файла.
            rm \"<файл>\""
        )
    ;
;


метод repeatCommand(ФайлИсторииКоманд: Файл): Строка
    исп ПотокЧтения = новый Файл(ФайлИсторииКоманд.Путь).ОткрытьПотокЧтения()
    пер ВсеВведенныеКоманды: Массив<Строка>
    знч Чтение = новый ЧтениеДанных(ПотокЧтения)
    пока не Чтение.ЧтениеЗавершено()
        ВсеВведенныеКоманды.Добавить(Чтение.ПрочитатьСтроку())
    ;
    пер ПредыдущаяКоманда = ВсеВведенныеКоманды[ВсеВведенныеКоманды.Граница() - 1]    
    возврат ПредыдущаяКоманда
    
;

метод history(ФайлИсторииКоманд: Файл): Массив<Строка>
    пер Текст: Строка
    пер Команды = ФайлИсторииКоманд
    исп ПотокЧтения = Команды.ОткрытьПотокЧтения() //
    пер Чтение = новый ЧтениеДанных(ПотокЧтения)
    // Консоль.Записать("\нФайл логов - \"$Команды\":\н")
    пер МассивКоманд: Массив<Строка>
    пока не Чтение.ЧтениеЗавершено()
        Текст = Чтение.ПрочитатьСтроку()
        // Консоль.Записать("    $Текст")
        МассивКоманд.Добавить(Текст)
    ;
    возврат МассивКоманд
;

метод historyActivate(Команда: Строка, ФайлИсторииКоманд: Файл)
    исп ПотокЗаписи = ФайлИсторииКоманд.ОткрытьПотокЗаписи(Истина)
    ПотокЗаписи.Записать("$Команда\н")
;


метод poweroff()
    пер Выбор = Консоль.СчитатьСтроку("Выйти из системы? [Д/н]  ")
    выбор Выбор.Сократить().ВНижнийРегистр()
    когда "y", "д"
        Консоль.Записать("Вы вышли из системы.")
    иначе
        Консоль.Записать("Отмена")
    ;
;

метод mkdir(Части: Массив<Строка>, Выполнение: Булево, Разд: Строка)//: Массив<Строка>
    //пер МассивСтрок: Массив<Строка>
    если Части.Размер() == 3
        пер Путь = Части[1]
        пер Имя = Части[2]
        пер ПутьККаталогу = "$Путь$Разд$Имя$Разд"
        если Путь.Содержит("/") или Путь.Содержит("\\")
            Файлы.СоздатьКаталог(ПутьККаталогу)
            Консоль.Записать("Папка создана: $ПутьККаталогу")
            //МассивСтрок.Добавить(ПутьККаталогу)
        иначе
            Консоль.Записать("Введите корректный путь.")
        ;
        Выполнение = Истина
    иначе
        Консоль.Записать("mkdir \"<путь>\" \"<имя папки>\" — создаёт папку")
    ;
    //возврат МассивСтрок
;

метод cat(Части: Массив<Строка>, ТекущаяПапка: Файл, Разд: Строка): Массив<Строка>
    пер Строка: Строка
    пер МассивСтрок: Массив<Строка>
    если Части.Размер() == 2 и (Части[1].Содержит("\\") или Части[1].Содержит("/"))
        пер Путь= Части[1]
        пер ФайлДляЧтения = новый Файл(Путь)
        если ФайлДляЧтения.Существует()
            исп ПотокЧтения = ФайлДляЧтения.ОткрытьПотокЧтения()
            пер Чтение = новый ЧтениеДанных(ПотокЧтения)
            пока не Чтение.ЧтениеЗавершено()
                Строка = Чтение.ПрочитатьСтроку()
                МассивСтрок.Добавить(Строка)
                // Консоль.Записать("    " + Строка)
            ;
        иначе
            // Консоль.Записать("Файл по адресу \"$Путь\" не существует.")
        ;
    // иначе если Части.Размер() == 2 и не Части[1].Содержит("\\") и не Части[1].Содержит("/")
    иначе если Части.Размер() == 2 и не Части[1].Содержит("\\") и не Части[1].Содержит("/")
    
        пер Путь = "${ТекущаяПапка.Путь}$Разд${Части[1]}"
        пер ФайлДляЧтения = новый Файл(Путь)
        если ФайлДляЧтения.Существует()
            исп ПотокЧтения = ФайлДляЧтения.ОткрытьПотокЧтения()
            пер Чтение = новый ЧтениеДанных(ПотокЧтения)
            // Консоль.Записать("\н    Файл \"$Путь\":\н")
            пока не Чтение.ЧтениеЗавершено()
                Строка = Чтение.ПрочитатьСтроку()
                МассивСтрок.Добавить(Строка)
                // Консоль.Записать("    " + Чтение.ПрочитатьСтроку())
            ;
        иначе
            // Консоль.Записать("Файл по адресу \"$Путь\" не существует.")
        ;
    иначе 
        // Консоль.Записать("cat <файл> — показать содержимое файла")
    ;
    возврат МассивСтрок
;

метод cd(Части: Массив<Строка>, ТекущаяПапка: Файл): Файл
// cd "/home/kuser/Документы/"
    если Части.Размер() >= 2
        пер НовыйПуть = Части[1]
        пер Папка = новый Файл(НовыйПуть)
        если Папка.Существует() и Папка.Расширение == ""
            ТекущаяПапка = Папка
            Консоль.Записать("Перешли в: \"${ТекущаяПапка.Путь}\"")
        иначе
            Консоль.Записать("Папка не найдена: \"$НовыйПуть\"")
        ;
        возврат ТекущаяПапка
    иначе    
        Консоль.Записать(
            "cd \"<путь>\" - изменить текущий рабочий каталог.
            (сейчас - $ТекущаяПапка)"
        )
    ;
    возврат ТекущаяПапка
;

метод ls(Части: Массив<Строка>, Настройки: НастройкиПоискаФайлов, ТекущаяПапка: Файл, РабочаяПапка: Строка, Разд: Строка, Выполнение: Булево): Массив<Строка>
    если Выполнение == Ложь
        пер ЕстьРекурсия = Ложь
        пер МассивОбъектов: Массив<Строка>
            для Индекс = 1 по Части.Размер() - 1
                если Части[Индекс] == "-r"
                    ЕстьРекурсия = Истина
                    прервать
                ;
            ;
            если ЕстьРекурсия
                Настройки.МаксимальнаяГлубина(Неопределено)
            ;
        
        если Части.Размер() == 1
            для Элемент из Файлы.Найти(ТекущаяПапка, Настройки)
                // Консоль.Записать(Элемент.Имя)
                МассивОбъектов.Добавить(Элемент.Имя)
            ;
            
        иначе если Части[1] == "dir" и Части.Размер() == 2
            для Элемент из Файлы.Найти(ТекущаяПапка, Настройки)
                если Элемент.Расширение == ""
                    // Консоль.Записать(Элемент.Имя)
                    МассивОбъектов.Добавить(Элемент.Имя)
                ;
            ;
            
        иначе если Части[1] == "files" и Части.Размер() == 2
            для Элемент из Файлы.Найти(ТекущаяПапка, Настройки)
                если Элемент.Расширение != ""
                    // Консоль.Записать(Элемент.Имя)
                    МассивОбъектов.Добавить(Элемент.Имя)
                ;
            ;
            
        иначе если Части[1] == ".txt" и Части.Размер() == 2
            для Файл из Файлы.Найти(ТекущаяПапка, Настройки)
                если Файл.Расширение == "txt"
                    // Консоль.Записать(Файл.Имя)
                    МассивОбъектов.Добавить(Файл.Имя)
                ;
            ;
            
        иначе
            // Консоль.Записать("Ошибка: Неизвестный(е) аргумент(ы).")
        ;
    возврат МассивОбъектов
    ;
    возврат новый Массив<Строка>()
    
;
метод echo(Части: Массив<Строка>, ТекущаяПапка: Файл, Разд: Строка): Массив<Строка>
    пер Текст: Массив<Строка>
    
    если Части.Размер() == 1
        // Консоль.Записать(Символы.НОВАЯ_СТРОКА)
        Текст = ["\н"]
    иначе если Части.Размер() == 2
        Текст = [Части[1]]
        // Консоль.Записать(Текст)
        
    иначе
        // Консоль.Записать("Неверные аргументы.")
    ;
    возврат Текст
;
метод clear()
    для Индекс = 1 по 100
        Консоль.Записать("\н")
    ;
;

метод Разделитель(): Строка
    пер Разделитель = "/"
    если СредаИсполнения.ПолучитьСвойство("os.name").Найти("Windows") != -1
        Разделитель = "\\"
    ;
    возврат Разделитель
;

метод ПоказатьASCIIArt()
    пер ИЮЗ = СредаИсполнения.ПолучитьПеременную("USER").Представление()
    пер ОСИ = СредаИсполнения.ПолучитьСвойство("os.name").Представление()
    пер ТДА = Дата.Сейчас().Представление("дд.ММ.гггг")
    пер ТВЯ = Время.Сейчас().Представление("ЧЧ:мм:сс")
    пер ВОС = СредаИсполнения.ПолучитьСвойство("os.version").Представление()
    пер АРХ = СредаИсполнения.ПолучитьСвойство("os.arch").Представление()
    пер ДПА = Файлы.ПолучитьДомашнийКаталогПользователя().Путь
    Консоль.Записать("                                                                           ")
    Консоль.Записать("    ╔═════════════════════════════════════╗                                ")
    Консоль.Записать("    ║     ███╗   ███╗██╗███╗   ██╗██╗     ║                                ")
    Консоль.Записать("    ║     ███║   ███║██║███║   ██║██║     ║  USER: $ИЮЗ                    ")
    Консоль.Записать("    ║     ████╗ ████║██║████╗  ██║██║     ║  OS: $ОСИ                      ")
    Консоль.Записать("    ║     ██╔████╔██║██║██╔██╗ ██║██║     ║  DATA: $ТДА                    ")
    Консоль.Записать("    ║     ██║████║██║██║██║██║ ██║██║     ║  TIME: $ТВЯ                    ")
    Консоль.Записать("    ║     ██║║██╔╝██║██║██║║██╗██║██║     ║  OS.VERSION: $ВОС              ")
    Консоль.Записать("    ║     ██║╚██║ ██║██║██║╚██║██║██║     ║  ARCHITECTURE: $АРХ            ")
    Консоль.Записать("    ║     ██║ ╚═╝ ██║██║██║ ╚████║██║     ║  HOME.FOLDER: $ДПА             ")
    Консоль.Записать("    ║     ╚═╝     ╚═╝╚═╝╚═╝  ╚═══╝╚═╝     ║                                ")
    Консоль.Записать("    ╚═════════════════════════════════════╝                                ")
    Консоль.Записать("                                                                           ")
;

метод ПарсерКоманды(Команда: Строка): Массив<Строка>
    пер Аргументы = новый Массив<Строка>()
    пер ТекущийАргумент = ""
    пер ВКавычках = Ложь
    пер Индекс = 1
    пока Индекс <= Команда.Длина()
        пер Символ = Команда.Подстрока(Индекс - 1, Индекс)
        если Символ == "\""
            ВКавычках = не ВКавычках  
        иначе если Символ == " " и не ВКавычках
            если ТекущийАргумент != ""
                Аргументы.Добавить(ТекущийАргумент)
                ТекущийАргумент = ""
            ;   
        иначе
            ТекущийАргумент = ТекущийАргумент + Символ
        ;
        Индекс = Индекс + 1
    ;
    если ТекущийАргумент != ""
        Аргументы.Добавить(ТекущийАргумент)
    ;
    возврат Аргументы
;

метод ПутьКРабочейПапкеИЕёСоздание(): Строка
    пер МестоРабочейПапки = "/home/${СредаИсполнения.ПолучитьПеременную("USER")}/Загрузки/#MiniShell"
    если СредаИсполнения.ПолучитьСвойство("os.name").Найти("Windows") != -1
        МестоРабочейПапки = "D:\\#MiniShell"
    ;
    Файлы.СоздатьКаталог(МестоРабочейПапки)
    возврат МестоРабочейПапки
;
